# ── OPC-UA Connection ──────────────────────────────────────────────────────
OPC_SERVER_URL=opc.tcp://CHANGE_ME:4840
OPC_USERNAME=
# Preferir OPC_PASSWORD_FILE (Docker Secret) frente a la variable en claro.
# Si el servidor OPC-UA no requiere usuario/contraseña, dejar ambas en blanco.
OPC_PASSWORD=
OPC_PASSWORD_FILE=/run/secrets/opc_password
OPC_SECURITY_POLICY=Basic256Sha256
OPC_SECURITY_MODE=SignAndEncrypt
OPC_CERTIFICATE_PATH=/certs/client_cert.pem
OPC_PRIVATE_KEY_PATH=/certs/client_key.pem
OPC_PUBLISH_INTERVAL_MS=500
OPC_DATACHANGE_DEADBAND=0.0
OPC_DEADBAND_TYPE=None
OPC_NAMESPACE_INDEX=
OPC_NODE_ID_FILTER=
# true: permite recortar el catálogo con OPC_TAG_OFFSET/OPC_TAG_LIMIT y registrar
# el recorte como warning. Por defecto false: si hay más variables que las
# seleccionadas, el descubrimiento aborta para no excluir tags en silencio.
# Solo el compose de escalado lo activa (particiona a propósito).
OPC_ALLOW_TAG_OMISSION=false
# Partición del catálogo (solo con OPC_ALLOW_TAG_OMISSION=true o en escalado).
# OPC_TAG_OFFSET=0
# OPC_TAG_LIMIT=5000
OPC_SESSION_TIMEOUT_MS=30000

# ── PostgreSQL / TimescaleDB (SERVIDOR REMOTO, no en este compose) ───────────
POSTGRES_HOST=db.internal.example
POSTGRES_PORT=5432
# verify-full  → recomendado (verifica CA + hostname; montar CA interna y PGSSLROOTCERT).
# verify-ca    → verifica CA sin hostname.
# require      → SOLO si la BD no tiene CA verificable (cifra sin autenticar, MITM posible).
# disable/prefer/allow → SOLO test local; generan warning.
POSTGRES_SSL_MODE=verify-full
# Ruta a la CA del servidor de BD si no está en el store del sistema.
# Necesaria para verify-ca/verify-full. En docker-compose.yml apunta a /certs/ca.pem.
# PGSSLROOTCERT=/certs/ca.pem
POSTGRES_DB=scada_db
POSTGRES_USER=connector_user
# Preferir POSTGRES_PASSWORD_FILE (Docker Secret) frente a la variable en claro
POSTGRES_PASSWORD=
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_CATALOG_TABLE=opc_tags_catalog
POSTGRES_DATA_TABLE=opc_raw_values
POSTGRES_BATCH_SIZE=1000
POSTGRES_FLUSH_INTERVAL_MS=500
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
# Timeout por comando SQL (s). P0: antes 60s bloqueaba el flush; 15s por defecto.
POSTGRES_COMMAND_TIMEOUT_S=15
# Writers COPY en paralelo (1-8). 2 por defecto para no saturar la BD.
POSTGRES_NUM_WRITERS=2
# Poner 0 SOLO si se conecta a través de pgBouncer en modo transaction
POSTGRES_STATEMENT_CACHE_SIZE=100
# true: TimescaleDB (hypertable + compresión). false: PostgreSQL plano (sin hypertable)
POSTGRES_USE_TIMESCALE=true

# ── Spill a disco (buffer persistente ante caídas largas de BD) ──────────────
POSTGRES_SPILL_ENABLED=true
POSTGRES_SPILL_DIR=/var/lib/connector/spill
POSTGRES_SPILL_MAX_MB=1024
POSTGRES_SPILL_SEGMENT_MB=64
# fsync cada N escrituras (durabilidad vs throughput). 1 = máximo (lento).
POSTGRES_SPILL_FSYNC_EVERY=100
# Timeout del drain del spill (s). Al agotarse NO se descartan datos: el lote
# queda sin ACK y se reintenta en el siguiente ciclo.
POSTGRES_SPILL_DRAIN_TIMEOUT_S=60

# ── Idempotencia / deduplicación ─────────────────────────────────────────────
# true: INSERT ... ON CONFLICT (event_id, ts) DO NOTHING (replay at-least-once
# seguro). Requiere el índice único creado por el inicializador.
POSTGRES_DEDUP_ENABLED=true

# ── Recuperación de huecos por reconexión OPC (HistoryRead) ──────────────────
# Tras resuscribir, lee el histórico desde el último ts persistido por tag hasta
# el momento de la suscripción. Requiere nodos historizados y soporte del
# servidor; si no, el hueco se registra como no recuperado.
HISTORY_RECOVERY_ENABLED=true
# Hueco máximo a intentar recuperar (s). Por encima se registra como
# gap_too_large sin leer (evita recuperaciones gigantes tras caídas largas).
HISTORY_RECOVERY_MAX_GAP_S=86400
# Valores por página/continuation point de HistoryRead.
HISTORY_RECOVERY_BATCH=1000
# Timeout por operación de HistoryRead (s).
HISTORY_RECOVERY_TIMEOUT_S=30

# ── Connector Identity / Operación ───────────────────────────────────────────
CONNECTOR_ID=connector-01
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_PORT=8000
RECONNECT_MAX_RETRIES=10
RECONNECT_BASE_DELAY_S=2
# Tiempo máximo para el drenado ordenado al recibir SIGTERM/SIGINT.
# Debe ser menor que stop_grace_period del contenedor (45s por defecto).
SHUTDOWN_TIMEOUT_S=30
OPC_QUEUE_MAX_SIZE=500000

# ── Logging ─────────────────────────────────────────────────────────────────────
OPC_LIB_LOG_LEVEL=WARNING
